---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: infisical-tls
  namespace: infisical
spec:
  secretName: infisical-tls
  issuerRef:
    name: letsencrypt-production
    kind: ClusterIssuer
  commonName: "infisical.internal.legohunter.io"
  dnsNames:
    - "infisical.internal.legohunter.io"