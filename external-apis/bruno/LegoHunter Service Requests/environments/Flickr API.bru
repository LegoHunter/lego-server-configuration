vars {
  flickr_rest_base_url: https://www.flickr.com/services/rest
  flickr_upload_base_url: https://up.flickr.com/services
  flickr_user_id: fill-me-in
  flickr_photoset_id: fill-me-in
  flickr_primary_photo_id: fill-me-in
  flickr_photo_id: fill-me-in
  flickr_album_title: 6390-1 - Main Street
  flickr_album_description: LegoHunter inventory item
  flickr_photo_title: Front view
  flickr_photo_description: LegoHunter photo metadata update
  flickr_photo_file_path: C:\path\to\photo.jpg
  flickr_oauth_timestamp: fill-me-in
  flickr_oauth_nonce: fill-me-in
}
vars:secret [
  flickr_oauth_signature,
  flickr_api_key,
  flickr_api_secret,
  flickr_oauth_token,
  flickr_oauth_token_secret
]
