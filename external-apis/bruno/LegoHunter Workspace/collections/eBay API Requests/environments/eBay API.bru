vars {
  ebay_api_base_url: https://api.ebay.com
  ebay_oauth_base_url: https://api.ebay.com
  ebay_marketplace_id: EBAY_US
  ebay_scope: https://api.ebay.com/oauth/api_scope
  ebay_search_query: Lego 6390
  ebay_item_id: v1|110000000000|0
  ebay_inventory_sku: LEGO-6390-1-EXAMPLE
}
vars:secret [
  ebay_client_id,
  ebay_client_secret,
  ebay_client_credentials_basic,
  ebay_access_token
]
