meta {
  name: Create Bitlink
  type: http
  seq: 2
}

post {
  url: {{bitly_base_url}}/bitlinks
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{bitly_access_token}}
  Content-Type: application/json
}

body:json {
  {
    "group_guid": "{{bitly_group_guid}}",
    "domain": "{{bitly_domain}}",
    "long_url": "{{bitly_long_url}}",
    "title": "LegoHunter example link"
  }
}
