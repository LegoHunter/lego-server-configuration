meta {
  name: Photosets - Edit Photos
  type: http
  seq: 4
}

post {
  url: {{flickr_rest_base_url}}/
  body: form-urlencoded
  auth: none
}

headers {
  Authorization: OAuth oauth_consumer_key="{{flickr_api_key}}", oauth_token="{{flickr_oauth_token}}", oauth_signature_method="HMAC-SHA1", oauth_timestamp="{{flickr_oauth_timestamp}}", oauth_nonce="{{flickr_oauth_nonce}}", oauth_version="1.0", oauth_signature="{{flickr_oauth_signature}}"
}

body:form-urlencoded {
  method: flickr.photosets.editPhotos
  photoset_id: {{flickr_photoset_id}}
  primary_photo_id: {{flickr_primary_photo_id}}
  photo_ids: {{flickr_primary_photo_id}},{{flickr_photo_id}}
  format: json
  nojsoncallback: 1
}
