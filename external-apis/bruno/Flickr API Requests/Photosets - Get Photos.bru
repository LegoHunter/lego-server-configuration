meta {
  name: Photosets - Get Photos
  type: http
  seq: 2
}

get {
  url: {{flickr_rest_base_url}}/?method=flickr.photosets.getPhotos&api_key={{flickr_api_key}}&photoset_id={{flickr_photoset_id}}&user_id={{flickr_user_id}}&extras=url_o,url_m,description,date_upload&format=json&nojsoncallback=1
  body: none
  auth: none
}

params:query {
  method: flickr.photosets.getPhotos
  api_key: {{flickr_api_key}}
  photoset_id: {{flickr_photoset_id}}
  user_id: {{flickr_user_id}}
  extras: url_o,url_m,description,date_upload
  format: json
  nojsoncallback: 1
}
