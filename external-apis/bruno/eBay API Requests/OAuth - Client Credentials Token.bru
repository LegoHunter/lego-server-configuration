meta {
  name: OAuth - Client Credentials Token
  type: http
  seq: 1
}

post {
  url: {{ebay_oauth_base_url}}/identity/v1/oauth2/token
  body: form-urlencoded
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded
  Authorization: Basic {{ebay_client_credentials_basic}}
}

body:form-urlencoded {
  grant_type: client_credentials
  scope: {{ebay_scope}}
}
